server {
    listen 443 ssl http2;
    server_name selos.exemplo.com.br;
    ssl_certificate     /etc/letsencrypt/live/selos.exemplo.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/selos.exemplo.com.br/privkey.pem;

    client_max_body_size 2g;          # >= "Envio máximo" configurado no sistema
    proxy_request_buffering off;      # envia o vídeo direto ao servidor, sem gravar em disco no nginx
    proxy_read_timeout 600s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server { listen 80; server_name selos.exemplo.com.br; return 301 https://$host$request_uri; }
